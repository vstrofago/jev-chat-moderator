{
  "compilerOptions": {
    "target": "es2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "lib": [
      "es2024",
      "dom"
    ]
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "packages/*/scripts/**/*",
    "apps/server/src/**/*",
    "apps/server/tests/**/*",
    "apps/desktop/src/**/*",
    "apps/desktop/tests/**/*"
  ],
  "exclude": [
    "packages/ui/**"
  ]
}
