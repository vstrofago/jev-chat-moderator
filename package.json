{
  "name": "vigia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted chat watchman for Twitch streamers, powered by TypeSafe AI's Jev.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @vigia/demo dev",
    "build": "pnpm --filter @vigia/demo build && pnpm --filter @vigia/ui build",
    "record": "pnpm --filter @vigia/demo record",
    "simulate": "pnpm --filter @vigia/engine simulate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui/tsconfig.json",
    "observe": "pnpm --filter @vigia/twitch observe",
    "live": "pnpm --filter @vigia/twitch live",
    "vigia": "pnpm --filter @vigia/server-app start",
    "eval": "pnpm --filter @vigia/evals eval",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  }
}
