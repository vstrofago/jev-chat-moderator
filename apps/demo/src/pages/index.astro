---
import "../styles/landing.css";
import es from "../i18n/landing.es.json";

// Spanish is rendered at build time; the client swaps strings for English on demand.
type Key = keyof typeof es;
const t = (key: Key) => es[key];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const repo = "https://github.com/vstrofago/vigia";
const blob = `${repo}/blob/main`;
const shot = (name: string) => `${base}shots/${name}.png`;
// The feature tour: one dashboard tab per slide.
const tourSlides = ["live", "uncertain", "highlights", "rules", "settings"] as const;
// Vigia's mark: a pixel bat, the night lookout. Drawn in currentColor.
const mark = [
  "X.....X.X.....X",
  "XX....XXX....XX",
  "XXX..XXXXX..XXX",
  ".XXXXXXXXXXXXX.",
  "..XXXXXXXXXXX..",
  "..X..XXXXX..X..",
  "......XXX......",
  ".......X.......",
]
  .flatMap((row, y) => [...row].map((c, x) => (c === "X" ? `M${x} ${y}h1v1h-1z` : "")))
  .join("");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("meta.title")}</title>
    <meta name="description" content={t("meta.description")} />
    <meta property="og:title" content={t("meta.title")} />
    <meta property="og:description" content={t("meta.description")} />
    <meta property="og:image" content={shot("dashboard-en-live")} />
    <link rel="icon" href={`${base}vigia.svg`} type="image/svg+xml" />
    <script is:inline>
      // Dark is the default; apply a saved light theme before first paint to avoid a flash.
      document.documentElement.classList.add("js");
      try {
        const saved = localStorage.getItem("jev-chat-moderator.theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#features" data-i18n="nav.skip">{t("nav.skip")}</a>
    <header class="topbar">
      <div class="container topbar-inner">
        <a class="logo" href={base} aria-label="Vigia">
          <svg class="logo-mark" aria-hidden="true" viewBox="0 0 15 8" shape-rendering="crispEdges"><path fill="currentColor" d={mark} /></svg>
          <span>Vigia</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="#features" data-i18n="nav.features">{t("nav.features")}</a>
          <a href="#spoilers" data-i18n="nav.spoilers">{t("nav.spoilers")}</a>
          <a href="#how" data-i18n="nav.how">{t("nav.how")}</a>
          <a href="#install" data-i18n="nav.install">{t("nav.install")}</a>
          <a href={`${base}playground/`} data-i18n="nav.playground">{t("nav.playground")}</a>
        </nav>
        <div class="tools">
          <a class="icon-link" href={repo} aria-label="GitHub">
            <svg aria-hidden="true" viewBox="0 0 16 16" width="18" height="18"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
          <button type="button" id="theme-toggle" class="icon-link" data-i18n-aria="theme.toggle" aria-label={t("theme.toggle")}>
            <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <div class="lang" role="group" aria-label="Language">
            <button type="button" data-lang="es" aria-pressed="true">ES</button>
            <button type="button" data-lang="en" aria-pressed="false">EN</button>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="grid-bg" id="grid-bg" aria-hidden="true"></div>
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow" data-i18n="hero.eyebrow">{t("hero.eyebrow")}</p>
            <h1 data-i18n="hero.title">{t("hero.title")}</h1>
            <p class="lead" data-i18n="hero.lead">{t("hero.lead")}</p>
            <div class="actions">
              <a class="btn btn-accent" href="#install" data-i18n="hero.cta">{t("hero.cta")}</a>
              <a class="btn btn-ghost" href={`${base}playground/`} data-i18n="hero.try">{t("hero.try")}</a>
            </div>
            <p class="note" data-i18n="hero.note">{t("hero.note")}</p>
          </div>

          <div class="stage" aria-hidden="true">
            <div class="chat">
              <div class="chat-head"><span class="dot"></span><span data-i18n="mock.channel">{t("mock.channel")}</span></div>
              <ul>
                <li class="row is-deleted">
                  <span class="who c1">freeviewz</span> <span class="text" data-i18n="mock.m1">{t("mock.m1")}</span>
                  <span class="chip chip-remove" data-i18n="mock.v1">{t("mock.v1")}</span>
                </li>
                <li class="row row-picked">
                  <span class="who c2">pixelpaula</span> <span class="text" data-i18n="mock.m2">{t("mock.m2")}</span>
                  <span class="chip chip-allow" data-i18n="mock.v2">{t("mock.v2")}</span>
                </li>
                <li class="row">
                  <span class="who c3">lorekeeper</span> <span class="text blurred" data-i18n="mock.m3">{t("mock.m3")}</span>
                  <span class="chip chip-spoiler" data-i18n="mock.v3">{t("mock.v3")}</span>
                </li>
                <li class="row is-deleted">
                  <span class="who c4">grumpy_gus</span> <span class="text" data-i18n="mock.m4">{t("mock.m4")}</span>
                  <span class="chip chip-remove" data-i18n="mock.v4">{t("mock.v4")}</span>
                </li>
                <li class="row">
                  <span class="who c5">tomkat</span> <span class="text" data-i18n="mock.m5">{t("mock.m5")}</span>
                </li>
                <li class="row">
                  <span class="who c6">rustyblade</span> <span class="text" data-i18n="mock.m6">{t("mock.m6")}</span>
                  <span class="chip chip-review" data-i18n="mock.v6">{t("mock.v6")}</span>
                </li>
              </ul>
            </div>
            <div class="overlay-layer">
              <span class="obs-tag" data-i18n="mock.obs">{t("mock.obs")}</span>
              <div class="overlay-card">
                <span class="overlay-label"><span class="rec"></span><span data-i18n="mock.overlay">{t("mock.overlay")}</span></span>
                <p><b>pixelpaula</b> <span data-i18n="mock.m2">{t("mock.m2")}</span></p>
                <span class="overlay-timer"></span>
              </div>
            </div>
          </div>
        </div>
        <dl class="container specs">
          {([1, 2, 3, 4] as const).map((n) => (
            <div>
              <dt data-i18n={`hero.spec.${n}.k`}>{t(`hero.spec.${n}.k`)}</dt>
              <dd data-i18n={`hero.spec.${n}.v`}>{t(`hero.spec.${n}.v`)}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="features" class="section">
        <div class="container section-grid">
          <div class="section-label">
            <p class="kicker"><span class="idx">01</span> — <span data-i18n="features.kicker">{t("features.kicker")}</span></p>
          </div>
          <div class="section-body">
            <h2 data-i18n="features.title">{t("features.title")}</h2>
            <div class="grid grid-3" data-reveal>
              {(["f1", "f2", "f3", "f4", "f5", "f6"] as const).map((f, i) => (
                <article class="cell">
                  <span class="num">{String(i + 1).padStart(2, "0")}</span>
                  <h3 data-i18n={`${f}.title`}>{t(`${f}.title`)}</h3>
                  <p data-i18n={`${f}.body`}>{t(`${f}.body`)}</p>
                </article>
              ))}
            </div>
            <div class="commands">
              <span data-i18n="features.commands">{t("features.commands")}</span>
              {(["cmd.1", "cmd.2", "cmd.3", "cmd.4"] as const).map((c) => (
                <code data-i18n={c}>{t(c)}</code>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container section-grid">
          <div class="section-label">
            <p class="kicker"><span class="idx">02</span> — <span data-i18n="dash.kicker">{t("dash.kicker")}</span></p>
          </div>
          <div class="section-body">
            <h2 data-i18n="dash.title">{t("dash.title")}</h2>
          </div>
          <div class="tour" data-reveal>
            <div class="tour-tabs" role="tablist" data-i18n-aria="tour.label" aria-label={t("tour.label")}>
              {tourSlides.map((slide, i) => (
                <button type="button" role="tab" id={`tour-tab-${i}`} aria-controls="tour-panel" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-slide={i}>
                  <span class="tour-num">{String(i + 1).padStart(2, "0")}</span>
                  <span class="tour-text">
                    <b data-i18n={`tour.${i + 1}.title`}>{t(`tour.${i + 1}.title` as Key)}</b>
                    <span class="tour-body"><span data-i18n={`tour.${i + 1}.body`}>{t(`tour.${i + 1}.body` as Key)}</span></span>
                  </span>
                  <span class="tour-progress" aria-hidden="true"></span>
                </button>
              ))}
            </div>
            <div class="tour-stage" id="tour-panel" role="tabpanel" aria-labelledby="tour-tab-0">
              <div class="tilt">
                {tourSlides.map((slide, i) => (
                  <img class={i === 0 ? "tour-shot on" : "tour-shot"} src={shot(`dashboard-es-${slide}`)} data-src-es={shot(`dashboard-es-${slide}`)} data-src-en={shot(`dashboard-en-${slide}`)} width="1280" height="800" loading={i === 0 ? "eager" : "lazy"} data-i18n-alt={`tour.${i + 1}.alt`} alt={t(`tour.${i + 1}.alt` as Key)} />
                ))}
                <span class="tilt-glare" aria-hidden="true"></span>
              </div>
              <p class="tour-caption"><span class="label">Fig. <span id="tour-fig">01</span></span> <span class="tour-count">/ {String(tourSlides.length).padStart(2, "0")}</span></p>
            </div>
          </div>
        </div>
      </section>

      <section id="spoilers" class="section">
        <div class="container section-grid">
          <div class="section-label">
            <p class="kicker"><span class="idx">03</span> — <span data-i18n="spoilers.kicker">{t("spoilers.kicker")}</span></p>
          </div>
          <div class="section-body split">
            <div>
              <h2 data-i18n="spoilers.title">{t("spoilers.title")}</h2>
              <p class="muted" data-i18n="spoilers.lead">{t("spoilers.lead")}</p>
              <p class="callout" data-i18n="spoilers.never">{t("spoilers.never")}</p>
              <a class="text-link" href={`${repo}/tree/main/spoiler-packs`} data-i18n="spoilers.packs">{t("spoilers.packs")}</a>
            </div>
            <ol class="layers" data-reveal>
              {(["s1", "s2", "s3"] as const).map((s, i) => (
                <li>
                  <span class="layer-num">{String(i + 1).padStart(2, "0")}</span>
                  <div>
                    <h3 data-i18n={`${s}.title`}>{t(`${s}.title`)}</h3>
                    <p data-i18n={`${s}.body`}>{t(`${s}.body`)}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <section id="how" class="section">
        <div class="container section-grid">
          <div class="section-label">
            <p class="kicker"><span class="idx">04</span> — <span data-i18n="how.kicker">{t("how.kicker")}</span></p>
          </div>
          <div class="section-body">
            <h2 data-i18n="how.title">{t("how.title")}</h2>
            <div class="grid grid-3" data-reveal>
              {(["how.1", "how.2", "how.3"] as const).map((s, i) => (
                <article class="cell">
                  <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
                  <h3 data-i18n={`${s}.title`}>{t(`${s}.title`)}</h3>
                  <p data-i18n={`${s}.body`}>{t(`${s}.body`)}</p>
                </article>
              ))}
            </div>
            <div class="scale" aria-hidden="true">
              <div class="scale-bar">
                <span class="zone zone-none"><b data-i18n="how.scale.none">{t("how.scale.none")}</b></span>
                <span class="zone zone-unsure"><b data-i18n="how.scale.unsure">{t("how.scale.unsure")}</b></span>
                <span class="zone zone-act"><b data-i18n="how.scale.act">{t("how.scale.act")}</b></span>
              </div>
              <div class="scale-ticks"><span>0</span><span style="left: 50%">50 %</span><span style="left: 85%">85 %</span><span style="left: 100%">100 %</span></div>
            </div>
            <a class="text-link" href={`${base}playground/`} data-i18n="how.playground">{t("how.playground")}</a>
          </div>
        </div>
      </section>

      <section id="install" class="section">
        <div class="container section-grid">
          <div class="section-label">
            <p class="kicker"><span class="idx">05</span> — <span data-i18n="install.kicker">{t("install.kicker")}</span></p>
          </div>
          <div class="section-body">
            <h2 data-i18n="install.title">{t("install.title")}</h2>
            <ol class="grid grid-3 start-steps" data-reveal>
              {([1, 2, 3] as const).map((n) => (
                <li class="cell">
                  <span class="num">{String(n).padStart(2, "0")}</span>
                  <h3 data-i18n={`start.${n}.title`}>{t(`start.${n}.title`)}</h3>
                  <p data-i18n={`start.${n}.body`}>{t(`start.${n}.body`)}</p>
                </li>
              ))}
            </ol>
            <article class="card install install-main">
              <div>
                <span class="badge" data-i18n="install.recommended">{t("install.recommended")}</span>
                <h3 data-i18n="install.desktop.title">{t("install.desktop.title")}</h3>
                <p class="os" data-i18n="install.desktop.os">{t("install.desktop.os")}</p>
                <p data-i18n="install.desktop.body">{t("install.desktop.body")}</p>
              </div>
              <div class="download">
                <a class="btn btn-accent btn-download" href={`${repo}/releases`} data-i18n="install.desktop.cta">{t("install.desktop.cta")}</a>
                <span class="soon" data-i18n="install.desktop.soon">{t("install.desktop.soon")}</span>
              </div>
            </article>
            <div class="grid-cards">
              <article class="card install">
                <h3 data-i18n="install.docker.title">{t("install.docker.title")}</h3>
                <p class="os" data-i18n="install.docker.os">{t("install.docker.os")}</p>
                <p data-i18n="install.docker.body">{t("install.docker.body")}</p>
                <pre><code>git clone {repo}
cd vigia
docker compose up --build</code></pre>
              </article>
              <article class="card install">
                <h3 data-i18n="install.pnpm.title">{t("install.pnpm.title")}</h3>
                <p class="os" data-i18n="install.pnpm.os">{t("install.pnpm.os")}</p>
                <p data-i18n="install.pnpm.body">{t("install.pnpm.body")}</p>
                <pre><code>pnpm install
pnpm --filter @vigia/ui build
pnpm --filter @vigia/desktop start</code></pre>
              </article>
            </div>
            <div class="note-row">
              <span data-i18n="install.note">{t("install.note")}</span>
              <a class="text-link" href={`${repo}#install`} data-i18n="install.guide">{t("install.guide")}</a>
              <button type="button" class="btn btn-soon" disabled>
                <span data-i18n="install.docs">{t("install.docs")}</span>
                <span class="soon-tag" data-i18n="install.soon">{t("install.soon")}</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-inverse">
        <div class="container section-grid">
          <div class="section-label">
            <p class="kicker"><span class="idx">06</span> — <span data-i18n="own.kicker">{t("own.kicker")}</span></p>
          </div>
          <div class="section-body">
            <h2 data-i18n="own.title">{t("own.title")}</h2>
            <div class="grid grid-3" data-reveal>
              {(["own.1", "own.2", "own.3"] as const).map((o, i) => (
                <article class="cell">
                  <span class="num">{String(i + 1).padStart(2, "0")}</span>
                  <h3 data-i18n={`${o}.title`}>{t(`${o}.title`)}</h3>
                  <p data-i18n={`${o}.body`}>{t(`${o}.body`)}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section section-community">
        <div class="container section-grid">
          <div class="section-label">
            <p class="kicker"><span class="idx">07</span> — <span data-i18n="community.kicker">{t("community.kicker")}</span></p>
          </div>
          <div class="section-body community">
            <div>
              <h2 data-i18n="community.title">{t("community.title")}</h2>
              <p class="muted" data-i18n="community.body">{t("community.body")}</p>
            </div>
            <div class="actions">
              <a class="btn btn-accent" href={`${blob}/CONTRIBUTING.md`} data-i18n="community.cta">{t("community.cta")}</a>
              <a class="btn btn-ghost" href={repo} data-i18n="community.github">{t("community.github")}</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <p><span class="wordmark">Vigia</span><span data-i18n="footer.made">{t("footer.made")}</span></p>
        <nav aria-label="Footer">
          <a href={repo} data-i18n="footer.github">{t("footer.github")}</a>
          <a href={`${base}playground/`} data-i18n="footer.playground">{t("footer.playground")}</a>
          <a href={`${blob}/CONTRIBUTING.md`} data-i18n="footer.contributing">{t("footer.contributing")}</a>
          <a href={`${blob}/SECURITY.md`} data-i18n="footer.security">{t("footer.security")}</a>
        </nav>
      </div>
    </footer>

    <script>
      import "../client/landing";
    </script>
  </body>
</html>
